{
  "name": "effectum",
  "version": "0.1.0",
  "description": "Local single-user sealed effect algebra runtime. Reified effects, composable interpreters, stack-safe trampoline. LLM calls are just effects. MIT core.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "lean"
  ],
  "scripts": {
    "build": "tsc",
    "example": "tsx src/examples/agent.ts",
    "test": "tsx --test src/**/*.test.ts",
    "mcp": "tsx src/mcp.ts"
  },
  "keywords": [
    "effects",
    "algebraic-effects",
    "trampoline",
    "lean",
    "llm",
    "agents",
    "effectum",
    "sealed-effects",
    "local-first",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwatso12026-bit/Effectum.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
