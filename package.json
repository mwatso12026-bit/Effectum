  "keywords": [
    "effects",
    "algebraic-effects",
    "trampoline",
    "lean",
    "llm",
    "agents",
    "reify",
    "sealed-effects"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
